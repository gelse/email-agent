<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M1T1 §5 integration-test project: WebApplicationFactory<Program> +
    Testcontainers Postgres. TargetFramework, Nullable, ImplicitUsings,
    TreatWarningsAsErrors and InvariantGlobalization come from
    Directory.Build.props.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- M1T8: bUnit for AuthFlowIntegrationTests (SPA pages over the real host). -->
    <PackageReference Include="bunit" Version="1.40.0" />
    <PackageReference Include="bunit.web" Version="1.40.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.32" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EmailAgent.Api/EmailAgent.Api.csproj" />
    <ProjectReference Include="../../src/EmailAgent.Contracts/EmailAgent.Contracts.csproj" />
    <!-- M2T4: the Greenmail-backed ImapMessageSource suite + GreenMailFixture. -->
    <ProjectReference Include="../../src/EmailAgent.Connectors.Imap/EmailAgent.Connectors.Imap.csproj" />
    <!-- M3T1: the OpenAI-compatible agent engine under test (internal seam via InternalsVisibleTo). -->
    <ProjectReference Include="../../src/EmailAgent.Connectors.OpenAI/EmailAgent.Connectors.OpenAI.csproj" />
    <ProjectReference Include="../../src/EmailAgent.Infrastructure/EmailAgent.Infrastructure.csproj" />
    <ProjectReference Include="../../src/EmailAgent.Spa/EmailAgent.Spa.csproj" />
    <!-- M3T1 (SQ-M3-7): the in-process OpenAI-compatible mock host (its own project). -->
    <ProjectReference Include="Mocks/OpenAIMock/OpenAIMock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      M3T1: Mocks/OpenAIMock is a SEPARATE project that happens to live inside
      this project's tree. Its sources — including the obj/ files the default
      **/*.cs glob would otherwise pick up (AssemblyInfo, GlobalUsings) — must
      never compile into this project: OpenAIMock.Program has to stay its own
      assembly for WebApplicationFactory<OpenAIMock.Program>.
    -->
    <Compile Remove="Mocks/OpenAIMock/**/*.cs" />
  </ItemGroup>
</Project>
