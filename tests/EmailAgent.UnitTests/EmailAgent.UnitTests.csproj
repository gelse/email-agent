<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M1T1 §5 unit-test project. TargetFramework, Nullable, ImplicitUsings,
    TreatWarningsAsErrors and InvariantGlobalization come from
    Directory.Build.props.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- M1T8: bUnit for the Blazor WASM pages (SPA test project scope). -->
    <PackageReference Include="bunit" Version="1.40.0" />
    <PackageReference Include="bunit.web" Version="1.40.0" />
    <!-- M9T2 NU1902 (GHSA-pgww-w46g-26qg / CVE-2026-54570, moderate): bUnit's
         transitive AngleSharp 1.2.0 is vulnerable; 1.5.0 is the patched
         release. Direct pin over the transitive floor (bunit stays 1.40.0). -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- M9T4 (milestone D3): must match the EF Core 10.0.14 line from M9T2 —
         an EF InMemory major below the framework throws MissingMethodException
         (AbstractionsStrings.ArgumentIsEmpty) at test runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <!-- M9T4 (milestone D3): 18.11.0 is contract-mandated. Verified green with
         xunit 2.9.3 + runner 2.8.2 under SDK 10 (R3 not triggered); do not
         downgrade without re-running the full suite. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EmailAgent.Api/EmailAgent.Api.csproj" />
    <ProjectReference Include="../../src/EmailAgent.Contracts/EmailAgent.Contracts.csproj" />
    <!-- M2T4: ImapConfig + ImapMessageSource pure-logic tests (internal seam via
         InternalsVisibleTo). -->
    <ProjectReference Include="../../src/EmailAgent.Connectors.Imap/EmailAgent.Connectors.Imap.csproj" />
    <!-- M3T1: OpenAICompatibleConfig + request-builder/SSE/mapper tests (internal seam
         via InternalsVisibleTo). -->
    <ProjectReference Include="../../src/EmailAgent.Connectors.OpenAI/EmailAgent.Connectors.OpenAI.csproj" />
    <ProjectReference Include="../../src/EmailAgent.Infrastructure/EmailAgent.Infrastructure.csproj" />
    <!-- M1T8: bUnit mounts the SPA pages directly. -->
    <ProjectReference Include="../../src/EmailAgent.Spa/EmailAgent.Spa.csproj" />
    <!-- M1T9: AuditVerify's internal AuditChainVerifier is the exact walk the
         CLI runs; InternalsVisibleTo on the tool lets the unit suite target it
         instead of a re-implementation. -->
    <ProjectReference Include="../../tools/AuditVerify/AuditVerify.csproj" />
  </ItemGroup>
</Project>
