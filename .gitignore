coverage/
TestResults/

# Generated build artifacts (CI workspace only — never committed; M0T6)
artifacts/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# ASP.NET
*.publish

# Plans and reports (local-only dev artifacts; tracked plans remain tracked)
plans/
reports/
