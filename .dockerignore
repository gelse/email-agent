# Build context is the repository root. Keep it lean.

# Build outputs / tooling
**/bin/
**/obj/
**/out/
**/.vs/
**/*.user
**/*.suo
**/coverage/
**/TestResults/

# VCS
.git/
.gitignore

# Local secrets / data (AGENTS.md #6)
.env
.env.*
!.env.example
/data/
data/

# Dev TLS material (Q-A13) is bind-mounted at run time, never baked into an
# image layer (`COPY . .` in the build stage would otherwise pick it up).
docker/certs/

# Docs and plans are not needed to build the images
plans/

# Keep: src/, *.sln, Directory.Build.props, global.json, docker/
