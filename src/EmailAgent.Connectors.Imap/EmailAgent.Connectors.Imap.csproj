<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M2T3 created the project; M2T4 fills in the DEFAULT IMAP connector
    implementation (MailKit). TargetFramework, Nullable, ImplicitUsings,
    TreatWarningsAsErrors and InvariantGlobalization come from
    Directory.Build.props.
  -->

  <PropertyGroup>
    <!-- Determinism for DefaultTrustAnchor: CI builds Debug, the local gates
         build Release, and the trust anchor pins ONE sha256 for this DLL —
         so every build configuration and tree state must emit byte-identical
         output. Four compiler facts are pinned here:
         - Optimize=true: Debug's default /optimize- would emit different IL;
         - GenerateAssemblyConfigurationAttribute=false: otherwise the PE
           carries AssemblyConfiguration("Debug"/"Release");
         - IncludeSourceRevisionInInformationalVersion=false: otherwise the
           .NET 8 SDK's built-in SourceLink appends "+<gitsha>[_dirty]" —
           a value that differs between a dirty local tree and CI's clean
           checkout;
         - DebugType=none: a portable PDB makes the PE depend on the PDB's
           identity and the absolute document/build paths, so the CodeView
           debug directory would differ per configuration and per checkout
           path — no PDB, no drift (verified empirically by hashing
           Debug/Release builds at two mount paths). -->
    <Optimize>true</Optimize>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- M2T4's real IMAP transport; referenced from M2T3 per the task file so
         the drop-in's dependency closure exists in the host graph. -->
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EmailAgent.Contracts/EmailAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as EmailAgent.Connectors.Imap.plugin.json — the loader's
         DEFAULT-plugin manifest source (no companion file on disk). -->
    <EmbeddedResource Include="plugin.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- M2T4: the suites reach the connector through its internal test seam
         (internal ImapMessageSource(IImapClientFactory), ImapConfig and the
         BODYSTRUCTURE extractor) instead of standing up a mail server for
         every pure-logic assertion. -->
    <InternalsVisibleTo Include="EmailAgent.UnitTests" />
    <InternalsVisibleTo Include="EmailAgent.IntegrationTests" />
  </ItemGroup>
</Project>
