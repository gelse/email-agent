<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M1T1 §5 infrastructure shell. TargetFramework, Nullable, ImplicitUsings,
    TreatWarningsAsErrors and InvariantGlobalization come from
    Directory.Build.props. The M1 packages below are added here in M1T1
    (step 5, one shot) so M1T2/M1T3/M1T4 land on a prepared project.
  -->

  <ItemGroup>
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="8.0.32" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.32" />
    <!-- Design-time assets for `dotnet ef` (M1T2 task step 10 — the
         EmailAgentDbContextFactory implements IDesignTimeDbContextFactory).
         No IncludeAssets restriction: unlike the startup-project pattern,
         this project compiles against the design-time interfaces. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
    <!-- M1T3: optionsBuilder.Bind(configuration.GetSection("System")) for
         EncryptionOptions (SYSTEM__KeyEncryptionKey, §16 / Q-E7). -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- ServiceCollectionExtensions resolves ConnectionStrings:Postgres via
         GetConnectionString; not otherwise in this project's graph. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <!-- 8.0.11 requires Npgsql >= 8.0.6, which unifies with EmailAgent.Api's
         direct Npgsql 8.0.6 pin (M0) across every project graph. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- M1T5: the tests exercise OtpService's pure generation/PBKDF2
         helpers (GenerateRawOtp / HashOtp / VerifyHash) without needing
         them on the public surface. -->
    <InternalsVisibleTo Include="EmailAgent.UnitTests" />
    <InternalsVisibleTo Include="EmailAgent.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EmailAgent.Core/EmailAgent.Core.csproj" />
  </ItemGroup>
</Project>
