<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M3T1: the DEFAULT OpenAI-compatible AGENT ENGINE plugin (replaces M2T3's
    stub). See EmailAgent.Connectors.Imap.csproj for the byte-identity
    rationale of the four properties below (CI=Debug, local gates=Release, one
    pinned sha256 in DefaultTrustAnchor).
  -->

  <PropertyGroup>
    <Optimize>true</Optimize>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EmailAgent.Contracts/EmailAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="plugin.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      M3T1: the internal test seam (internal OpenAICompatibleConfig) reaches
      the suites the same way M2T4's ImapConfig does. System.Net.Http.Json is
      deliberately NOT referenced: it is inbox in net8.0 and nothing in this
      plugin needs its extension methods (JSON bodies go through
      StringContent + the shared OpenAIJsonOptions instance).
    -->
    <InternalsVisibleTo Include="EmailAgent.UnitTests" />
    <InternalsVisibleTo Include="EmailAgent.IntegrationTests" />
  </ItemGroup>
</Project>
