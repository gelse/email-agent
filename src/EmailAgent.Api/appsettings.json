{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Blobs": {
    "Path": "/data/blobs"
  },
  "Auth": {
    "Issuer": "email-agent",
    "Audience": "email-agent-spa",
    "AccessTokenTtl": "00:15:00",
    "RefreshTokenTtl": "14.00:00:00"
  },
  "Otp": {
    "Lifetime": "7.00:00:00"
  },
  "Spa": {
    "AllowedOrigins": ""
  },
  "Api": {
    "PublicBaseUrl": ""
  }
}
