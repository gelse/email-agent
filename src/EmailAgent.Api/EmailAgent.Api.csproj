<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    M0T2 web host, completed by M1T1 (verify-and-extend — SQ-M0-9/Q-API43).
    TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors and
    InvariantGlobalization come from Directory.Build.props.
  -->

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- M1T2 step 14: AddDbContextCheck<EmailAgentDbContext>(name: "db") —
         the DbContext-backed readiness check that replaces M1T1's TCP ping. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <!-- Design-time assets for `dotnet ef` (startup project per M1T2 step 1);
         compile assets are intentionally excluded by the standard pattern. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- M9T2 NU1902 (GHSA-g94r-2vxg-569j / CVE-2026-40894, moderate): the
         1.9.x keep-list OTel packages below pull OpenTelemetry.Api 1.9.0,
         which is vulnerable; 1.15.3 is the patched release. Direct pin raises
         only the Api package — the rest of the OTel keep-list stays 1.9.x. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <!-- Acceptance criterion 4 requires process_runtime_* series at /metrics;
         only this instrumentation emits them. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EmailAgent.Core/EmailAgent.Core.csproj" />
    <ProjectReference Include="../EmailAgent.Contracts/EmailAgent.Contracts.csproj" />
    <ProjectReference Include="../EmailAgent.Infrastructure/EmailAgent.Infrastructure.csproj" />
    <!-- M2T3: the three DEFAULT connector plugins ride along into the host
         output (and transitively into the test hosts' AppContext.BaseDirectory)
         — that is where the loader's DefaultTrustAnchor finds them (§5). -->
    <ProjectReference Include="../EmailAgent.Connectors.Imap/EmailAgent.Connectors.Imap.csproj" />
    <ProjectReference Include="../EmailAgent.Connectors.OpenAI/EmailAgent.Connectors.OpenAI.csproj" />
    <ProjectReference Include="../EmailAgent.Connectors.Telegram/EmailAgent.Connectors.Telegram.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      M3T2 (deviation D3): the probe seam is internal — IModelProbeService /
      ModelProbeService take M3T1's internal OpenAICompatibleConfig, and CS0051
      forbids exposing it through a public Api member. The suites construct the
      service directly (fake IAgentEngine / in-process OpenAIMock), so they are
      granted the Api's internals. Deliberately the same friend list
      Connectors.OpenAI uses: every type reachable from the internal seam must
      be visible to each granted assembly.
    -->
    <InternalsVisibleTo Include="EmailAgent.UnitTests" />
    <InternalsVisibleTo Include="EmailAgent.IntegrationTests" />
  </ItemGroup>
</Project>
