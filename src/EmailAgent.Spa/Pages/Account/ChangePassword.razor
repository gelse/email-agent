@page "/account/change-password"
@page "/user/account/change-password"
@inject HttpClient Api
@inject TokenStore TokenStore
@inject NavigationManager Nav

<PageTitle>@_title — Email Agent</PageTitle>

<div class="auth-card">
    <h1>@_title</h1>
    @if (FirstLogin)
    {
        <p class="hint">You are setting this account's password for the first time.</p>
    }

    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="change-password">
        <DataAnnotationsValidator />
        @if (!FirstLogin)
        {
            <div class="form-field">
                <label for="old-password">Current password</label>
                <InputText id="old-password" type="password" class="form-control"
                           @bind-Value="_model.OldPassword" autocomplete="current-password" />
            </div>
        }
        <div class="form-field">
            <label for="new-password">New password</label>
            <InputText id="new-password" type="password" class="form-control"
                       @bind-Value="_model.NewPassword" autocomplete="new-password" />
            <ValidationMessage For="@(() => _model.NewPassword)" />
        </div>
        <div class="form-field">
            <label for="new-password-confirm">Confirm new password</label>
            <InputText id="new-password-confirm" type="password" class="form-control"
                       @bind-Value="_model.NewPasswordConfirm" autocomplete="new-password" />
            <ValidationMessage For="@(() => _model.NewPasswordConfirm)" />
        </div>
        <button type="submit" class="btn-primary" disabled="@_busy">
            @(_busy ? "Saving…" : "Set password")
        </button>
        @if (_error is not null)
        {
            <div class="error-box" role="alert">@_error</div>
        }
    </EditForm>
</div>

@code {
    /// <summary>
    /// <c>true</c> for the M1 first-login flow at
    /// <c>/account/change-password</c> (default); <c>false</c> for the M6a
    /// subsequent flow at <c>/user/account/change-password</c>, which also
    /// renders the current-password field (task scope bullet 3).
    /// </summary>
    [Parameter]
    public bool FirstLogin { get; set; } = true;

    private ChangePasswordModel _model = new();
    private string? _error;
    private bool _busy;
    private string _title = "Choose your password";

    protected override void OnInitialized()
    {
        // The route decides the flow: the /user/… route (M6a) carries no
        // route parameter, so the path itself selects the subsequent shape.
        if (Nav.ToBaseRelativePath(Nav.Uri)
            .StartsWith("user/", StringComparison.OrdinalIgnoreCase))
        {
            FirstLogin = false;
        }

        _title = FirstLogin ? "Choose your password" : "Change your password";
        _model = new ChangePasswordModel();
    }

    /// <summary>
    /// POST /v1/account/change-password (first-login shape: new_password +
    /// new_password_confirm only) or POST /v1/user/account/change-password
    /// (subsequent shape adds old_password). On success the first-login
    /// flow continues to /account/set-passphrase while the session flag says
    /// key material is still missing (dek_wrapped was NULL at login), else
    /// straight to / (task scope bullet 3).
    /// </summary>
    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var body = new ChangePasswordBody
            {
                OldPassword = FirstLogin ? null : _model.OldPassword,
                NewPassword = _model.NewPassword,
                NewPasswordConfirm = _model.NewPasswordConfirm,
            };
            var path = FirstLogin
                ? "/v1/account/change-password"
                : "/v1/user/account/change-password";

            using var response = await Api.PostAsJsonAsync(path, body);
            if (!response.IsSuccessStatusCode)
            {
                _error = await ProblemReader.ReadAsync(response);
                return;
            }

            if (TokenStore.NeedsPassphraseSetup)
            {
                Nav.NavigateTo("/account/set-passphrase");
            }
            else
            {
                Nav.NavigateTo("/");
            }
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the API.";
        }
        catch (OperationCanceledException)
        {
            _error = "Could not reach the API.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ChangePasswordModel
    {
        public string? OldPassword { get; set; }

        [Required(ErrorMessage = "The new password is required.")]
        [MinLength(12, ErrorMessage = "The new password must be at least 12 characters.")]
        public string? NewPassword { get; set; }

        [Required(ErrorMessage = "The new password confirmation is required.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new passwords do not match.")]
        public string? NewPasswordConfirm { get; set; }
    }

    private sealed class ChangePasswordBody
    {
        // Omitted on the wire for the first-login shape (never sent when null)
        // so the form is exactly { new_password, new_password_confirm }.
        [JsonPropertyName("old_password")]
        [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
        public string? OldPassword { get; init; }

        [JsonPropertyName("new_password")]
        public string? NewPassword { get; init; }

        [JsonPropertyName("new_password_confirm")]
        public string? NewPasswordConfirm { get; init; }
    }
}