# .env.example — committed. Names only; no secret values.
# Copy to .env and fill real (throwaway-in-dev) values: cp .env.example .env
# .env is gitignored (AGENTS.md #6).

# Secrets (fill in .env; never commit .env)
# POSTGRES_PASSWORD must not contain ';', single or double quotes, and must
# not start or end with whitespace — it is embedded into the api container's
# ConnectionStrings__Postgres by docker/entrypoint.sh (which fails fast on
# such characters; Npgsql trims surrounding whitespace).
POSTGRES_PASSWORD=
AUTH__SigningKey=
system_kek=
# M1T1: audit-chain HMAC key, materialized as AUDIT__HmacKey by
# docker/entrypoint.sh (§16 / Q-O10; >= 32 bytes in any real deployment).
AUDIT__HmacKey=
# Format (kept for CI bootstrapping, scripts/smoke.sh's ad-hoc container, and
# local `dotnet` runs; the compose `api` service no longer consumes it —
# docker/entrypoint.sh derives the connection string from the postgres secret):
#   Host=postgres;Port=5432;Database=emailagent;Username=emailagent;Password=<POSTGRES_PASSWORD>
ConnectionStrings__Postgres=

# Optional
# M1T8/Q-A13: only the web (nginx) container is host-published in dev — it
# serves the SPA and reverse-proxies /v1/*, /health/* and /metrics (the api
# service publishes no host port; §13.9 same-origin topology). The canonical
# dev URL is https://localhost:8443 (WEB_HTTPS_PORT), TLS terminated by the
# web container with a throwaway self-signed certificate — generate it once
# with `bash scripts/gen-dev-cert.sh` (nginx fails to start without it);
# browsers warn and curl needs -k. WEB_PORT stays the plain-HTTP listener
# for health/metrics tooling (smoke.sh).
WEB_PORT=8081
WEB_HTTPS_PORT=8443
Blobs__Path=/data/blobs

# Optional: first-admin bootstrap consumed by scripts/seed-dev.sh (it reads
# these from its own environment, not from this file; defaults shown).
# BOOTSTRAP__AdminEmail=admin@local
# BOOTSTRAP__AdminPassword=
